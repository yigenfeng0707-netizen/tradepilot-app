# 复制为 .env 后填写；勿提交 .env / 勿把密钥写入仓库

# mock = 规则引擎 + 模板（无外网）
# api  = 魔搭 API-Inference 开源模型（扣魔粒 / 文本免费额度）；失败回退规则
LLM_MODE=api
LLM_PROVIDER=modelscope

# 魔搭 Token：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# 兼容旧字段（可与 MODELSCOPE_API_KEY 二选一）
LLM_API_KEY=

LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# 以 GET /v1/models 现役列表为准；推荐开源 Qwen3.5
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
LLM_FALLBACK_MODEL=Qwen/Qwen3.5-27B
LLM_TIMEOUT_SEC=90

HOST=0.0.0.0
PORT=8787

# 可选：覆盖默认 SQLite 路径
# DATABASE_URL=sqlite:///D:/path/to/tradepilot.db

PREPAID_RISK_THRESHOLD=0.30
CORS_ORIGINS=["http://127.0.0.1:8787","http://localhost:8787"]

# ---- P2+ 可选基础设施（默认关闭，不破坏本地 smoke）----
# 鉴权：AUTH_DISABLED=1 或 JWT_SECRET 空 → 跳过 Bearer 校验
AUTH_DISABLED=1
# JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=1440
# DEMO_PASSWORD=demo

# Celery：默认同步流水线；开启后可 ?async=1 入队
CELERY_ENABLED=0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# MinIO：未配置或连接失败 → 继续用本地 data/
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tradepilot
MINIO_SECURE=0
