# 复制为 .env 后填写；勿提交 .env / 勿把密钥写入仓库

# mock = 规则引擎 + 模板（无外网）
# api  = 魔搭 API-Inference 开源模型（扣魔粒 / 文本免费额度）；失败回退规则
LLM_MODE=api
LLM_PROVIDER=modelscope

# 魔搭 Token：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# 兼容旧字段（可与 MODELSCOPE_API_KEY 二选一）
LLM_API_KEY=

LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# 以 GET /v1/models 现役列表为准；推荐开源 Qwen3.5
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
LLM_FALLBACK_MODEL=Qwen/Qwen3.5-27B
LLM_TIMEOUT_SEC=90

HOST=0.0.0.0
PORT=8787

# 可选：覆盖默认 SQLite 路径
# DATABASE_URL=sqlite:///D:/path/to/tradepilot.db

PREPAID_RISK_THRESHOLD=0.30
CORS_ORIGINS=["http://127.0.0.1:8787","http://localhost:8787"]
